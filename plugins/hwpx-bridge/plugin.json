{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "hwpx-bridge",
  "version": "0.2.1",
  "description": "Windows용 HWPX 읽기·작성·변환과 로컬 OCR. Filee + kordoc, Node.js 자동 준비.",
  "author": {
    "name": "HWPX Bridge contributors"
  },
  "license": "MIT",
  "keywords": [
    "hwpx",
    "hwp",
    "docx",
    "ocr",
    "korean",
    "local-mcp"
  ],
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/setup/SKILL.md",
      "interface": {
        "displayName": "HWPX Bridge",
        "shortDescription": "한글 문서 작성·변환·OCR",
        "developerName": "HWPX Bridge contributors",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "defaultPrompt": [
          "HWPX Bridge 최초 설정을 진행해줘.",
          "이 DOCX를 HWPX로 변환해줘.",
          "이 내용으로 HWPX 보고서를 만들어줘."
        ]
      }
    }
  }
}
